# %% Barplot Quantification Smad3
import decoupler as dc
from dotools_py.tl._Statistical import DGEAnalysis

visium_subset = do.get.subset(visium, "timepoint", ["3_month", "d28"], copy=True)
visium_subset = dc.pp.pseudobulk(visium_subset, sample_col="sample", groups_col="AnatomicRegion", layer="counts")
visium_subset = visium_subset[visium_subset.obs["AnatomicRegion"].isin(["BZ", "IZ", "LV", "RZ"])].copy()
visium_subset.layers["counts"] = visium_subset.X.copy()
dc.pp.filter_samples(visium_subset, min_cells=10, min_counts=1000)

tester = DGEAnalysis(data=visium_subset, group_by="AnatomicRegion", is_pseudobulk=True, batch_key="sample")
tester.edger(design="~AnatomicRegion", reference="LV", groups=["BZ", "IZ", "RZ"])
df = tester.get_dge["EdgeR"]
