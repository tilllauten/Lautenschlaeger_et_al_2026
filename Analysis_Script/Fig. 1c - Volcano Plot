# Vulcano plot - ATAC DERs

```{r}
#Import data and libaries
setwd("/Users/tilllautenschlager/OneDrive - Johann Wolfgang Goethe Universität/Uni/PhD/Bioinformatic/23_LongTermAMI/For Publication/")

library(dplyr)
library(ggplot2)
library(ggrepel)
library(readxl)


# Import ATAC data excel
ATAC <- read_excel("/Users/tilllautenschlager/Library/CloudStorage/OneDrive-JohannWolfgangGoetheUniversität/Uni/PhD/Bioinformatic/23_LongTermAMI/Analysis/snATAC_Mice_AMI_d28_Till/FromTill/DifferentialPeak_Footprinting_fromLooso/MBC_Ctl_vs_AMI/markers_leiden01/Endothelial_cl_2_cond_markers_list.xlsx", sheet = 3) %>% 
  filter(pvals < 0.05, !is.na(gene_name), gene_name != "") %>%
  select(gene_name, logfoldchanges, pvals, pvals_adj)

# Keep only the most significant peak per gene
ATAC_unique <- ATAC %>%
  group_by(gene_name) %>%
  slice_min(order_by = pvals_adj, n = 1) %>%
  ungroup()


#Filter out extreme log-fold changes
foldchange_threshold <- 5
ATAC_unique <- ATAC_unique %>%
filter(abs(logfoldchanges) <= foldchange_threshold)

padj_cutoff <- 0.05

# Prepare volcano data
ATAC_volcano <- ATAC_unique %>%
  mutate(
    negLog10Padj = -log10(pvals_adj),
    sig_status = case_when(
      pvals_adj < padj_cutoff & logfoldchanges > 0 ~ "Up in AMI",
      pvals_adj < padj_cutoff & logfoldchanges < 0 ~ "Down in AMI",
      TRUE ~ "Not Sig"
    )
  )

# Genes of interest
genes_of_interest <- c("Ciita", "Zbtb16")
label_genes <- unique(genes_of_interest)

# Filter data for labeling
ATAC_labels <- ATAC_volcano %>% filter(gene_name %in% label_genes)

# Only color labels if they are genes_of_interest, otherwise grey
ATAC_labels <- ATAC_labels %>%
  mutate(label_color = ifelse(gene_name %in% genes_of_interest, sig_status, "Other"))

# Volcano plot
p_ATAC <- ggplot(ATAC_volcano, aes(x = logfoldchanges, y = negLog10Padj)) +
  geom_point(aes(color = sig_status), size = 2, alpha = 1) +  # dots colored by sig_status
  geom_vline(xintercept = 0, linetype = "longdash", linewidth = 0.5, color = "grey50") +
  geom_hline(yintercept = -log10(padj_cutoff), linetype = "longdash", linewidth = 0.5, color = "grey50") +
  geom_label_repel(
    data = ATAC_labels,
    aes(label = gene_name, fill = label_color),  # labels colored by label_color
    color = "white",
    size = 3.5,
    label.size = 0.2,
    box.padding = 0,
    point.padding = 0,
    segment.color = "grey20",
    segment.size = 0.5,
    force = 2,
    max.overlaps = 10,
    ylim = c(2.3, NA))+
  scale_color_manual(values = c(
    "Down in AMI" = "#1083C5",
    "Up in AMI"   = "#D62728",
    "Not Sig"     = "grey80"
  )) +
  scale_fill_manual(values = c(
    "Down in AMI" = "#1083C5",
    "Up in AMI"   = "#D62728",
    "Other"       = "grey60"  # labels for non-genes-of-interest
  )) +
  labs(
    title = "DNA Accessibility\nin endothelial cluster (snATAC)",
    x = "ATAC Accessibility\n (log2-fold change)",
    y = expression(-log[10]("adj. p-value"))) +
  theme_classic(base_size = 12) +
  theme(
    legend.position = "none",
    axis.line = element_line (linewidth = 0.5),
    axis.text = element_text(color = "black", size = 14)
  )

p_ATAC

ggsave( filename = "ATAC_Volcano_V2.pdf", plot = p_ATAC, path = "./", units = "cm", width = 9, height = 14, limitsize = FALSE)
```

