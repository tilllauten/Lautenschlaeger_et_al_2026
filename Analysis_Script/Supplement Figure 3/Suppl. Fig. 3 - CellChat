## Create CellChat objects

```{r}

#Prepare Dataset for CellChat calculation
CellChat.AMI <- list()
CellChat.HFrEF <- list()
AMI <- c("ctrl_HFrEF", "HFrEF", "ctrl_ami", "d28_ami")

levels(Myo.integrated$disease)
#Allocate more resources
  future::plan("multisession", workers = 4)  # Do parallel processing
  options(future.globals.maxSize = 4 * 1024^3)

#Generate CellChat object and save it. Additionally a list of all CellChat Objects is generated for merging later
for(i in AMI){
  print(i)
  
  cellchat <- createCellChat(subset(Myo.integrated, disease == i), assay = "RNA", group.by = 'cell_type')
  
  CellChatDB <- CellChatDB.mouse
  showDatabaseCategory(CellChatDB)

  cellchat@DB <- CellChatDB

  # Subset the expression data of signaling genes for saving computation cost
  cellchat <- subsetData(cellchat)  # This step is necessary even if using the whole database
  cellchat <- identifyOverExpressedGenes(cellchat)
  cellchat <- identifyOverExpressedInteractions(cellchat)
  cellchat <- computeCommunProb(cellchat)
  cellchat <- filterCommunication(cellchat)
  cellchat <- computeCommunProbPathway(cellchat)
  cellchat <- netAnalysis_computeCentrality(cellchat)
  cellchat <- aggregateNet(cellchat)
  
  name <- paste(i, sep = "_")
  
  
  saveRDS(cellchat, paste0("~/OneDrive - Johann Wolfgang Goethe Universität/Uni/PhD/Bioinformatic/23_LongTermAMI/Analysis/snRNA.scRNA.Integrated.Data_AMI.HFrEF/TL-012-CellChat/240916_CC.Object_", name, ".rds"))
  
  if(grepl("HFrEF", name)){ 
  CellChat.HFrEF[[name]] <- cellchat
  } else { 
   CellChat.AMI[[name]] <- cellchat }
}

#Save the generated list of CellChat Objects
save(CellChat.AMI, file ="./24.09.16_CC.List.AMI.RData")
save(CellChat.HFrEF, file = "./24.09.16_CC.List.HFrEF.RData")
```

