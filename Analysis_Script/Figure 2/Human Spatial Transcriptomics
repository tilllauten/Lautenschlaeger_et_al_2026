    'IZ_P16': "IZ",
    'RZ_BZ_P12': "RZ_BZ",
    'FZ_P18': "FZ",
    'FZ_GT_P19': "FZ",
    'GT_IZ_P15': "IZ"
})
adata_concat.X = adata_concat.layers["counts"].copy()

do.utility.free_memory()
sc.pp.normalize_total(adata_concat, target_sum=10_000)
sc.pp.log1p(adata_concat)
adata_concat.layers["logcounts"] = adata_concat.X.copy()

adata_concat = adata_concat[adata_concat.obs.region.isin(["Control", "RZ", "IZ", "FZ"])].copy()
del database
import gc
gc.collect()


pdata = dc.pp.pseudobulk(adata_concat, sample_col="donor_id", groups_col="region", layer="counts")
pdata.layers["counts"] = pdata.X.copy()
pdata_copy = pdata.copy()

dc.pp.filter_samples(pdata, min_cells=10, min_counts=1000)
dc.pp.filter_by_expr(pdata)

tester = DGEAnalysis(
    data=pdata,
    group_by="region",
    batch_key="donor_id",
    is_pseudobulk=True
)

# Test for IZ
iz = adata_concat[adata_concat.obs.region.isin(["Control", "IZ"])]
sc.pp.filter_genes(iz, min_cells=5)  # Otherwise we are keeping all the genes
iz.obs["condition"] = iz.obs["region"]
tester = DGEAnalysis(
    data=iz, group_by="condition", batch_key="donor_id", is_pseudobulk=False
)
tester.mast(reference="Control", groups=["IZ"], layer="logcounts", covariates="donor_id")
dge = tester.get_dge["mast"]
print(dge[dge.GeneName == "CIITA"])
