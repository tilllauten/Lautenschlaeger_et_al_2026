import os
import pathlib
import matplotlib.pyplot as plt
import numpy as np
from tqdm import tqdm
import dotools_py as do
import anndata as ad
import scanpy as sc
from dotools_py.tl._Statistical import DGEAnalysis
import decoupler as dc

files = [f for f in os.listdir("/mnt/davidr/scStorage/DavidR/BioData/AMI_Kuppe_Spatial_2022/Objects") if
         "snRNA" not in f]

path = pathlib.Path("/mnt/davidr/scStorage/DavidR/BioData/AMI_Kuppe_Spatial_2022/Objects")
outpath = pathlib.Path("/mnt/davidr/ZMM_shared/DavidR/Requests/Till/Manuscript")
sc.set_figure_params(scanpy=False, vector_friendly=True)


database = {}
for f in tqdm(files):
    adata = ad.read_h5ad(path / f)
    del adata.raw
    del adata.uns["spatial"]["is_single"]
    # sc.pl.spatial(adata, color=None, title=f)
    sc.pp.normalize_total(adata, target_sum=10_000)
    sc.pp.log1p(adata)
    adata.var_names = adata.var["feature_name"]
    sc.pl.spatial(adata, color="CIITA", size=1.5, title=f)

database = {}
for f in tqdm(files):
    if "BZ" in f:
        continue
    if "IZ_BZ" in f:
        continue
    if "RZ_BZ" in f:
        continue
    if "RZ_FZ" in f:
        continue

    adata = ad.read_h5ad(path / f)
    adata.var_names = adata.var["feature_name"].astype(str)
    adata.var_names_make_unique()
    print("\n")
    try:
        adata.layers["counts"] = adata.raw.X.copy()
        print("adata.layers: ", adata.layers["counts"].data)
        del adata.raw
    except AttributeError as e:
        adata.layers["counts"] = adata.X.copy()
        print("adata.X: ", adata.X.data)
    name = f.split(".h5ad")[0].strip()
    database[name] = adata

adata_concat = ad.concat(database.values(), keys=database.keys(), label="name", fill_value=0, index_unique="-")
adata_concat.obs["region"] = adata_concat.obs["name"].map({
    'IZ_BZ_P2': "IZ_BZ",
    'RZ_BZ_P2': "RZ_BZ",
    'IZ_P3': "IZ",
    'RZ_P6': "RZ",
    'RZ_GT_P2': "RZ",
    'control_P1': "Control",
    'IZ_P15': "IZ",
    'control_P7': "Control",
    'RZ_P6_2': "RZ",
    'FZ_GT_P4': "FZ",
    'FZ_P20': "FZ",
    'control_P17': "Control",
    'control_P8': "Control",
    'GT_IZ_P13': "IZ",
    'RZ_BZ_P3': "RZ_BZ",
    'RZ_FZ_P5': "RZ_FZ",
    'RZ_P9': "RZ",
    'IZ_P10': "IZ",
    'RZ_P11': "RZ",
    'RZ_P3': "RZ",
    'FZ_P14': "FZ",
    'GT_IZ_P9': "IZ",
