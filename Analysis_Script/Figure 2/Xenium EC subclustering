import pathlib
import matplotlib
matplotlib.use("TkAgg")

import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import zscore
import scanpy as sc
import dotools_py as do

sc.set_figure_params(scanpy=False, vector_friendly=True, dpi_save=300)

xenium_path = "/mnt/davidr/scStorage/DavidR/Spatial/Xenium/Results/Objects/AMId28_slide2.h5ad"
outdir_path = pathlib.Path("/mnt/davidr/ZMM_shared/DavidR/Requests/Till/Manuscript/")

xenium = sc.read_h5ad(xenium_path)

xenium.X = xenium.layers["logcounts"].copy()
xenium.obs_names = xenium.obs_names.astype(str)
