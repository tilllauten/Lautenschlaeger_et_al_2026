# Markers from ECs in Xenium
xenium = sc.read_h5ad("C:/Users/tilll/OneDrive - Johann Wolfgang Goethe Universität/Desktop/stXenium/AMId28_slide2.h5ad")

xenium.X = xenium.layers["logcounts"].copy()
xenium.obs_names = xenium.obs_names.astype(str)
xenium.obs_names_make_unique()

xenium_ecs = xenium[xenium.obs["annotation"].isin(["ArtEC", "CapEC", "EndoEC", "LymphEC", "VeinEC"])]

sc.tl.pca(xenium_ecs)
sc.pp.neighbors(xenium_ecs, use_rep="X_pca")
sc.tl.umap(xenium_ecs)

do.pl.umap(xenium_ecs, "annotation", labels="annotation", show=True, filename="UMAP_Xenium_ECsSubclustering.pdf")
do.pl.umap(xenium_ecs, ["Cdh5", "Vwf", "Mmrn1", "Rgcc", "Sema3g"])

do.tl.rank_genes_groups(xenium_ecs, "annotation")
sc.pl.rank_genes_groups_dotplot(xenium_ecs)

df = do.get.mean_expr(xenium_ecs, "annotation",
                      ["Cdh5", "Pecam1",
                       "Vwf", "Nrg1",
                       "Mmrn1", "Lyve1",
                       "Rgcc", "Kdr",
                       "Sema3g", "Hey1",
                       "Nr2f2", "Vcam1"], out_format="wide")

df_zscore = df.apply(zscore)
df_zscore = df_zscore.reindex(index=["Cdh5", "Pecam1",
                                     "Sema3g", "Hey1",
                                     "Nr2f2", "Vcam1",
                                     "Rgcc", "Kdr",
                                     "Lyve1", "Mmrn1",
                                     "Vwf", "Nrg1"],
                              columns=["ArtEC", "VeinEC", "CapEC", "LymphEC", "EndoEC"])

fig, axs = plt.subplots(1, 1, figsize=(4, 5))
sns.heatmap(df_zscore, cmap="RdBu_r", center=0, vmax=2.5, vmin=-2.5, ax=axs, square=True)
axs.set_xlabel("")
axs.set_ylabel("")
axs.set_title("Xenium")
plt.savefig(outdir_path / "Heatmap_XeniumMarkersECs.pdf", bbox_inches="tight")

