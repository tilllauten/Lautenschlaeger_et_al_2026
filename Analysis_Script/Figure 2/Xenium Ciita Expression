# %% Barplot Ciita in ECs subtypes

for ct in ["ArtEC", "VeinEC", "CapEC", "EndoEC", "LymphEC"]:
    xenium_ct = do.get.subset(xenium, "annotation", ct, copy=True)
    pct = dc.pp.pseudobulk(xenium_ct, sample_col="batch", groups_col="condition", layer="counts")
    dc.pp.filter_samples(pct, min_cells=10, min_counts=1000)

    tester = DGEAnalysis(pct, group_by="condition", batch_key="batch", is_pseudobulk=True)
    tester.edger(design="~condition", reference="sham", groups=["ami"])
    df = tester.get_dge["EdgeR"]
    df = df[df.GeneName == "Ciita"]
    df.set_index("group", inplace=True)

    xenium_ct.obs["regions"] = xenium_ct.obs["condition"].map({
        "ami": "MI_day28",
        "sham": "Sham",
    })

    if ct in ["ArtEC", "EndoEC"]:
        ylim = 0.05
    elif ct == "CapEC":
        ylim = 0.04
    else:
        ylim = 0.06

    do.pl.barplot(xenium_ct, "regions", "Ciita", batch_key="batch",
                  title=f"Ciita in {ct}",
                  xticks_order=["Sham", "MI_day28"],
                  palette={"Sham": "#A0A0A4", "MI_day28": "#FF0000"},
                  reference="Sham", groups=["MI_day28"],
                  groups_pvals=[df.loc["ami", "padj"]],
                  figsize=(3, 6), txt="", txt_size=12, path=outdir_path, ylim_max=ylim,
                  filename=f"Barplot_Ciita_Xenium_ShamVsMIday28_{ct}_edgeR.pdf"
                  )

